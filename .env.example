NODE_ENV=development
PORT=8080
# Origem do front-end (CORS com credentials + redirect final do login Google)
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/sistema_controle_despesas

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Access token (JWT stateless) — curto de propósito, ver docs/plano-api-node-express.md seção 5.
JWT_EXPIRES_IN=15m
# Refresh token (opaco, rotativo, revogável — guardado com hash na tabela RefreshToken)
REFRESH_TOKEN_EXPIRES_IN=7d

# Login com Google é opcional. Preencha as 4 variáveis abaixo juntas pra habilitar,
# ou deixe todas em branco pra rodar só com login/registro por credenciais.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback
COOKIE_SESSION_SECRET=

# Desarma os rate limiters (SEC-01) para rodar a suíte e2e do front localmente, que
# precisa de ~22 cadastros por execução contra o teto de 10/hora do REGISTER_LIMIT. Só
# tem efeito com NODE_ENV=development — em produção e em test é ignorada de propósito.
RATE_LIMIT_DISABLED=false

# Tetos dos limitadores, um por limitador. Em branco = o padrão do código
# (src/middlewares/rateLimit.ts): global 120/min, login 8/15min, registro 10/h,
# refresh 30/15min, forgot-password 5/h, reset-password 10/h.
#
# Ao contrário de RATE_LIMIT_DISABLED, estas valem TAMBÉM em produção — é o que permite
# o e2e orquestrado (repo sistema-controle-despesas-deploy) rodar contra a imagem de
# produção de verdade, só com os tetos afrouxados. Afrouxar mantém o limitador montado
# na rota e o desvio sai no log de boot (evento rate_limit_override); desarmar, não.
# Num servidor de verdade, deixe todas em branco.
RATE_LIMIT_GLOBAL=
RATE_LIMIT_LOGIN=
RATE_LIMIT_REGISTER=
RATE_LIMIT_REFRESH=
RATE_LIMIT_FORGOT_PASSWORD=
RATE_LIMIT_RESET_PASSWORD=

# --- Recuperação de senha por email ---
# Validade do link de redefinição.
PASSWORD_RESET_TOKEN_EXPIRES_IN=30m
# Caminho da tela de redefinição no front-end (o link = FRONTEND_URL + este caminho + ?token=)
PASSWORD_RESET_PATH=/change-password

# SMTP — as 5 variáveis abaixo são "tudo ou nada" (ver D-08 do plano). Deixe TODAS
# em branco pra rodar sem envio de email (em dev o link é impresso no console).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Armazenamento de comprovantes (Amazon S3) ---
# S3_REGION e S3_BUCKET são o par que LIGA o upload (D-18). Deixe os dois em branco para
# rodar sem storage: a API sobe normal, a confirmação de recebimento continua funcionando,
# e só o anexo de comprovante responde 503.
S3_REGION=
S3_BUCKET=

# Credenciais explícitas: só em desenvolvimento. Em produção elas ficam VAZIAS e o SDK
# pega a credencial da role da task no ECS (provider chain) — nunca coloque chave de
# acesso longa em produção.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Só para apontar a um S3 compatível (MinIO/LocalStack). Vazio = AWS de verdade.
S3_ENDPOINT=

RECEIPT_MAX_SIZE_BYTES=5242880
RECEIPT_UPLOAD_URL_EXPIRES_IN=300
RECEIPT_DOWNLOAD_URL_EXPIRES_IN=300
